# ESP32-S3 N8R8 hardware class
CONFIG_IDF_TARGET="esp32s3"
CONFIG_IDF_TARGET_ESP32S3=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 8 MB QIO Flash at 80 MHz
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHFREQ="80m"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# 8 MB octal PSRAM at 80 MHz
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# Runtime scheduling and diagnostics
CONFIG_FREERTOS_HZ=1000
# Building the full Micro UI tree (dozens of LVGL widgets incl.
# list/tabview) needs more than the default 4 KB main-task stack;
# an overflow used to panic in vApplicationStackOverflowHook.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y

# Product partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_8m.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions_8m.csv"

# The shared Micro UI font assets generated by scripts/generate-font-assets.py
# are produced by `lv_font_conv` with the default RLE compression (see the
# `.bitmap_format = 1` field in each micro_ui_sans_*.c). Enable the matching
# decompressor in LVGL or every text glyph decompresses to an empty buffer and
# stays invisible on the LCD.
CONFIG_LV_USE_FONT_COMPRESSED=y

# The OS app bar keeps the default 14 px Montserrat Wi-Fi symbol. App icons use
# the dedicated 42-glyph micro_icons_* subset fonts instead of full Montserrat
# faces (~21 KiB vs ~110 KiB of flash).
CONFIG_LV_FONT_MONTSERRAT_14=y


CONFIG_SPIRAM_USE_MALLOC=y

CONFIG_LV_USE_STDLIB_MALLOC=1

# Momo/clock: one SNTP server is enough (micro_clock sets pool.ntp.org).
CONFIG_LWIP_SNTP_MAX_SERVERS=1

# External SD card: the storage API accepts normal App filenames, so FATFS
# needs long-file-name support. The heap variant keeps the LVGL task stack
# small; without LFN only 8.3 names like `notes.txt` would mount.
CONFIG_FATFS_LFN_HEAP=y
# CONFIG_FATFS_LFN_NONE is not set

# micro_sd uses FATFS directly for directory operations. Rust's std and mbedTLS
# still reference the POSIX opendir/mkdir/readdir symbols, which newlib's
# libnosys provides; VFS's versions collide with them in the final link. VFS
# directory support is unused by this firmware, so leave those symbols to
# libnosys and keep VFS for file I/O.
CONFIG_VFS_SUPPORT_DIR=n

# App HTTPS (net.httpRequestWithHeaders / net.lookupWords). esp_http_client
# validates Maimemo and Youdao against the common certificate bundle; the
# common set is half the flash of the full bundle and covers both DigiCert
# chains. Without the bundle https:// URLs fail closed instead of silently
# falling back to clear text, so keep it enabled for momo sync.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
